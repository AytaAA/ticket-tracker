# OPTIONAL. The app starts without a .env: docker-compose.yml has the same values below as defaults.
# To change a setting:   cp .env.example .env   and edit .env (it is git-ignored).
# Never commit real passwords or SMTP credentials. This file is the source of truth for variable names.

# --- Database (PostgreSQL container) ---
POSTGRES_DB=tickets
POSTGRES_USER=tickets
# Use letters, digits, "-" and "_" only: the password is put into the database URL unencoded.
POSTGRES_PASSWORD=change-me-local-only

# --- Ports on this computer (change them if 8080 / 8025 are already in use) ---
APP_PORT=8080
MAILPIT_PORT=8025

# --- Backend ---
# Public URL of the app, used to build the link in the verification email.
# Leave it out to use http://localhost:<APP_PORT>.
# APP_BASE_URL=http://localhost:8080

# --- SMTP (email verification, requirement §3.4) ---
# Default: local Mailpit container. Open http://localhost:8025 to read the emails.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=no-reply@ticket-tracker.local

# Company relay example (only reachable from the DataArt network/VPN).
# Port and sender address are NOT confirmed yet: check with IT/organizers before relying on them.
# SMTP_HOST=relay1.dataart.com
# SMTP_PORT=25
# SMTP_STARTTLS=false
# SMTP_FROM=<your-allowed-sender-address>

# --- Auth (defaults shown) ---
# Hours a verification link stays valid (§3.6 requires 24)
# VERIFICATION_TOKEN_HOURS=24
# Minimum seconds between two verification emails to one address (protects the SMTP relay)
# RESEND_COOLDOWN_SECONDS=60
# Days a login session lasts
# SESSION_DAYS=7
# Set to true when the app is served over HTTPS, so the session cookie gets the Secure flag
# COOKIE_SECURE=false
# Seconds to wait for the SMTP server
# SMTP_TIMEOUT_SECONDS=10
